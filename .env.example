# Base URL / API Key / 模型名由用户在设置中填写。
# 新服务密钥默认只保留在当前页面会话内；显式勾选“记住密钥”才写入 localStorage。
# 密钥与字幕经 /api/translate 发送到所选模型端点，不应写进源码或部署环境。

# 默认公网模式：仅允许内置的官方 HTTPS origin，拒绝所有重定向。
ALLOW_PRIVATE_ENDPOINTS=false

# 自定义服务由部署管理员审核后按完整 origin 放行，逗号分隔，不含 /v1 或其他路径。
# 不要添加不可信、用户可控制 DNS 或提供开放代理功能的域名。
# ALLOWED_API_ORIGINS=https://llm.example.com,https://gateway.example.com:8443

# 本地/受控私有部署接 Ollama 时可显式设为 true，此时取消公网 origin 白名单限制。
# 不得把该模式作为无认证的公网服务开放。
# localhost 是运行此应用服务器的机器，不是访问网页的用户电脑。
# ALLOW_PRIVATE_ENDPOINTS=true
